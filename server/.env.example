# Copy this file to .env and fill in the key.

# --- Choose ONE provider and fill in its details ---

# Option A: Google Gemini (free tier, no card needed)
# Get a key: https://aistudio.google.com/app/apikey
OPENAI_API_KEY=your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# Option B: Groq (free tier, no card needed)
# Get a key: https://console.groq.com/keys
# OPENAI_API_KEY=your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option C: OpenAI itself (needs credit at platform.openai.com)
# Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Rest of the server settings ---
PORT=3000
